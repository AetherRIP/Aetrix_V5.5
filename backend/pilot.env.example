# Aetrix V5.5 — single-credential pilot configuration (NOT ACTIVE)
#
# This is a fragment to merge into backend/.env, not a replacement: backend/.env
# also holds the database URL and the credential encryption key, and copying this
# file over it would destroy them. Nothing reads this file; the pilot stays
# inactive until these values are placed in backend/.env, migration 0039 has been
# applied, and the worker is started deliberately.
#
# Policy: one pinned credential, one model, one pass. No other key may be leased,
# including after a 429 — the operation stops instead. This pin does not create a
# fresh Google allowance: if that key's project is shared or already exhausted,
# the pilot stops with the recorded 429 rather than continuing on a sibling.

# Inactive on purpose. Flip to true only as the explicit go/no-go step.
AETRIX_FEATURES__LIVE_PROVIDER=false

# Marking only. gemini-3.6-flash is the sole permitted marking model; no lite
# fallback and no second model in the chain.
AETRIX_PROVIDER__MODEL_PRIMARY=gemini-3.6-flash
AETRIX_PROVIDER__TRANSCRIPTION_MODEL=
AETRIX_PROVIDER__TRANSCRIPTION_ROLE_ENABLED=false
AETRIX_PROVIDER__INDEPENDENT_REVIEW_MODEL=
AETRIX_PROVIDER__INDEPENDENT_REVIEW_ROLE_ENABLED=false

# The one credential this pilot may use: the key with the most recent confirmed
# success (2026-11-24T16:56Z). Nothing is substituted when it is unavailable.
AETRIX_PROVIDER__PINNED_CREDENTIAL_ID=85d2bd43-b030-4a79-aa74-8a9a1cdeb27d

# The pilot gate: about twenty flash requests in the operation, and one retry of
# a transient failure at most (MAX_TRANSIENT_RETRIES caps it at one anyway).
AETRIX_QUOTA__REQUESTS_PER_DAY=20
AETRIX_QUOTA__REQUESTS_PER_MINUTE=3
AETRIX_PROVIDER__MAX_ATTEMPTS=2
