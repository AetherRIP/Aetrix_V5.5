# Aetrix V5.5 engine — environment template.
# Copy to backend/.env (git-ignored) and fill in real values.
# Never commit a filled-in copy.

AETRIX_ENV=development
AETRIX_DEBUG=false
AETRIX_API_PREFIX=/api/v1

# PostgreSQL (Supabase or any PostgreSQL 15+). No SQLite is accepted.
# Session-mode pooler URL for migrations; use the direct database host if reachable.
AETRIX_DATABASE__URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth. Either a JWKS URL (asymmetric keys, preferred) or the legacy
# HS256 JWT secret. DEV MODE IS REJECTED IN PRODUCTION.
AETRIX_AUTH__SUPABASE_URL=https://<project-ref>.supabase.co
AETRIX_AUTH__JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AETRIX_AUTH__JWT_SECRET=
AETRIX_AUTH__JWT_AUDIENCE=authenticated
AETRIX_AUTH__DEV_MODE=false
AETRIX_AUTH__DEV_TENANT_ID=
AETRIX_AUTH__DEV_USER_ID=

# Fernet key for encrypting provider credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AETRIX_SECURITY__ENCRYPTION_KEY=

# CORS (comma-separated; empty in production is valid for a same-origin frontend)
AETRIX_CORS_ORIGINS=http://localhost:3000

# Provider. LIVE_PROVIDER=false keeps every job parked with an explicit reason;
# it never substitutes a fake marking response.
AETRIX_FEATURES__LIVE_PROVIDER=false
AETRIX_PROVIDER__GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AETRIX_PROVIDER__MODEL_PRIMARY=gemini-3.6-flash
AETRIX_PROVIDER__MODEL_REVIEW=gemini-3.1-pro-preview
AETRIX_PROVIDER__REQUEST_TIMEOUT_SECONDS=300
AETRIX_PROVIDER__MAX_ATTEMPTS=4

# Quota policy. Counted per Google Cloud project and per model, never per key:
# every key in one project shares this allowance. These defaults are Aetrix
# policy and are reported as ESTIMATED; only a limit recorded with source
# "google" (AETRIX_QUOTA__MODEL_LIMITS) is reported as CONFIRMED.
AETRIX_QUOTA__REQUESTS_PER_MINUTE=10
AETRIX_QUOTA__REQUESTS_PER_DAY=200
AETRIX_QUOTA__REVIEW_BUDGET_SHARE=0.25
# Tokens per minute, per project and model. Empty means unknown: the estimate
# says UNKNOWN rather than dividing by a made-up number.
AETRIX_QUOTA__TOKENS_PER_MINUTE=
# Daily free-tier reset (Google resets at midnight Pacific).
AETRIX_QUOTA__DAILY_RESET_TIMEZONE=America/Los_Angeles
AETRIX_QUOTA__ALERT_THRESHOLD=0.8
AETRIX_QUOTA__MONITORING_INTERVAL_SECONDS=300

# Marking / review policy.
AETRIX_MARKING__REVIEW_MODE=BALANCED
AETRIX_MARKING__BLUEPRINT_APPROVAL_REQUIRED=true
AETRIX_MARKING__MAX_ESCALATIONS_PER_JOB=6
AETRIX_MARKING__MIN_CONFIDENCE=0.6

# Worker (the API does not start workers; run `aetrix-worker` separately).
AETRIX_WORKER__CONCURRENCY=2
AETRIX_WORKER__POLL_INTERVAL_SECONDS=1.0
AETRIX_WORKER__LEASE_SECONDS=60
AETRIX_WORKER__HEARTBEAT_SECONDS=20
AETRIX_WORKER__MAX_ATTEMPTS=3

# Storage (Phase 2; local directory for development).
AETRIX_STORAGE__BACKEND=local
AETRIX_STORAGE__ROOT=./data/documents

# Integration tests only. Never used by the application.
AETRIX_TEST_DATABASE_URL=
