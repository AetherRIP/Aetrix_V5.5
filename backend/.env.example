# Aetrix V5.5 engine — environment template.
# Copy to backend/.env (git-ignored) and fill in real values.
# Never commit a filled-in copy.

AETRIX_ENV=development
AETRIX_DEBUG=false
AETRIX_API_PREFIX=/api/v1

# PostgreSQL (Supabase or any PostgreSQL 15+). No SQLite is accepted.
# Session-mode pooler URL for migrations; use the direct database host if reachable.
AETRIX_DATABASE__URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth. Either a JWKS URL (asymmetric keys, preferred) or the legacy
# HS256 JWT secret. DEV MODE IS REJECTED IN PRODUCTION.
AETRIX_AUTH__SUPABASE_URL=https://<project-ref>.supabase.co
AETRIX_AUTH__JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AETRIX_AUTH__JWT_SECRET=
AETRIX_AUTH__JWT_AUDIENCE=authenticated
AETRIX_AUTH__DEV_MODE=false
AETRIX_AUTH__DEV_TENANT_ID=
AETRIX_AUTH__DEV_USER_ID=

# Open access (optional). When true, a verified identity with no invitation is
# admitted to ONE shared workspace instead of receiving 403
# PROVISIONING_REQUIRED. The workspace is named here, never by the caller, so
# reads stay scoped to it and other tenants still return 404. Every admission is
# audited as `member.provisioned` with `method: open_access`. Leave false to
# keep provisioning invitation-only. The workspace is created on first sign-in.
AETRIX_AUTH__OPEN_ACCESS=false
AETRIX_AUTH__OPEN_ACCESS_TENANT_SLUG=pilot
AETRIX_AUTH__OPEN_ACCESS_TENANT_NAME=Pilot workspace
AETRIX_AUTH__OPEN_ACCESS_ROLE=TEACHER

# Fernet key for encrypting provider credentials and Classroom tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AETRIX_SECURITY__ENCRYPTION_KEY=

# Google Classroom (optional). Create a Web application OAuth client in Google
# Cloud, enable the Google Classroom API on the same project, and register the
# redirect URI byte for byte. The URI points at the frontend callback, which
# forwards the code to the authenticated engine; the client secret never
# leaves the engine. Without these the Classroom routes report
# CLASSROOM_NOT_CONFIGURED instead of pretending to be connected.
AETRIX_CLASSROOM__CLIENT_ID=
AETRIX_CLASSROOM__CLIENT_SECRET=
AETRIX_CLASSROOM__REDIRECT_URI=http://127.0.0.1:3000/auth/classroom
AETRIX_CLASSROOM__MAX_COURSES=2000

# Google Cloud quota and usage synchronisation (read-only).
# A Gemini API key is NOT a Google Cloud IAM credential and is never used here.
# The service-account JSON must live outside the repository (a mounted secret is
# preferred); never commit it. The account needs only the four read roles in
# docs/architecture/GOOGLE_CLOUD_QUOTA.md. When unconfigured, the dashboard says
# so and no Google request is attempted.
AETRIX_GOOGLE_CLOUD__ENABLED=true
AETRIX_GOOGLE_CLOUD__SERVICE_ACCOUNT_FILE=
# Alternative to the file for a secret manager that injects JSON. Prefer the file.
AETRIX_GOOGLE_CLOUD__SERVICE_ACCOUNT_JSON=
AETRIX_GOOGLE_CLOUD__USE_METADATA=false
AETRIX_GOOGLE_CLOUD__SERVICE=generativelanguage.googleapis.com
# Scheduled sync runs in the worker beside correction jobs, never inside one.
AETRIX_GOOGLE_CLOUD__SYNC_INTERVAL_SECONDS=900
AETRIX_GOOGLE_CLOUD__STALE_AFTER_SECONDS=3600
AETRIX_GOOGLE_CLOUD__REQUEST_TIMEOUT_SECONDS=20
AETRIX_GOOGLE_CLOUD__MAX_ATTEMPTS=3
AETRIX_GOOGLE_CLOUD__BACKOFF_SECONDS=1.0
AETRIX_GOOGLE_CLOUD__MAX_QUOTA_INFOS=2000
AETRIX_GOOGLE_CLOUD__USAGE_WINDOW_MINUTES=15

# CORS: exact origins of the deployed frontend and the local preview.
# Never a wildcard for authenticated endpoints; production refuses one.
AETRIX_CORS_ORIGINS=https://aetrix.pages.dev,http://localhost:3000,http://127.0.0.1:3000

# Provider. LIVE_PROVIDER=false keeps every job parked with an explicit reason;
# it never substitutes a fake marking response.
AETRIX_FEATURES__LIVE_PROVIDER=false
AETRIX_PROVIDER__GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AETRIX_PROVIDER__MODEL_PRIMARY=gemini-3.6-flash
AETRIX_PROVIDER__MODEL_REVIEW=gemini-3.1-pro-preview
AETRIX_PROVIDER__REQUEST_TIMEOUT_SECONDS=300
AETRIX_PROVIDER__MAX_ATTEMPTS=4

# Quota policy. Counted per Google Cloud project and per model, never per key:
# every key in one project shares this allowance. These defaults are Aetrix
# policy and are reported as ESTIMATED; only a limit recorded with source
# "google" (AETRIX_QUOTA__MODEL_LIMITS) is reported as CONFIRMED.
AETRIX_QUOTA__REQUESTS_PER_MINUTE=10
AETRIX_QUOTA__REQUESTS_PER_DAY=200
AETRIX_QUOTA__REVIEW_BUDGET_SHARE=0.25
# Tokens per minute, per project and model. Empty means unknown: the estimate
# says UNKNOWN rather than dividing by a made-up number.
AETRIX_QUOTA__TOKENS_PER_MINUTE=
# Daily free-tier reset (Google resets at midnight Pacific).
AETRIX_QUOTA__DAILY_RESET_TIMEZONE=America/Los_Angeles
AETRIX_QUOTA__ALERT_THRESHOLD=0.8
AETRIX_QUOTA__MONITORING_INTERVAL_SECONDS=300

# Correction engine. Two are registered: `aetrix_legacy` (default, marks every
# paper) and `mathchecker_v5` (selectable, raises EngineNotImplemented).
# There is no fallback — a name this build does not contain stops the worker
# with CONFIGURATION_ERROR instead of marking with something else.
AETRIX_ENGINE__CORRECTION_ENGINE=aetrix_legacy

# Marking / review policy.
AETRIX_MARKING__REVIEW_MODE=BALANCED
AETRIX_MARKING__BLUEPRINT_APPROVAL_REQUIRED=true
AETRIX_MARKING__MAX_ESCALATIONS_PER_JOB=6
AETRIX_MARKING__MIN_CONFIDENCE=0.6
# Independent second marking of the least certain awards. Off by default; a
# disagreement goes to a teacher and never replaces the first award.
AETRIX_MARKING__DOUBLE_CHECK_ENABLED=false
AETRIX_MARKING__DOUBLE_CHECK_MIN_CONFIDENCE=0.85
AETRIX_MARKING__DOUBLE_CHECK_MAX_QUESTIONS=8

# Worker (the API does not start workers; run `aetrix-worker` separately).
AETRIX_WORKER__CONCURRENCY=2
AETRIX_WORKER__POLL_INTERVAL_SECONDS=1.0
AETRIX_WORKER__LEASE_SECONDS=60
AETRIX_WORKER__HEARTBEAT_SECONDS=20
AETRIX_WORKER__MAX_ATTEMPTS=3

# Storage (Phase 2; local directory for development).
AETRIX_STORAGE__BACKEND=local
AETRIX_STORAGE__ROOT=./data/documents

# Platform account management (server-side only).
# The service-role key can administer every Supabase account: keep it in the
# engine's secret environment (a deployment secret manager), never in the
# frontend, never in a VITE_ variable and never in git. When it is absent the
# account screen reports ADMIN_NOT_CONFIGURED and workspace features still work.
AETRIX_PLATFORM_ADMIN__SUPABASE_URL=https://<project-ref>.supabase.co
AETRIX_PLATFORM_ADMIN__SERVICE_ROLE_KEY=
AETRIX_PLATFORM_ADMIN__TIMEOUT_SECONDS=15
# Ceiling per read; when reached the API says the list is truncated.
AETRIX_PLATFORM_ADMIN__MAX_ACCOUNTS=5000
AETRIX_PLATFORM_ADMIN__PAGE_SIZE=200
# Seconds the overview reuses its Supabase role census. 0 disables the cache;
# the dashboard's manual refresh bypasses it either way.
AETRIX_PLATFORM_ADMIN__CENSUS_TTL_SECONDS=60

# Integration tests only. Never used by the application.
AETRIX_TEST_DATABASE_URL=
