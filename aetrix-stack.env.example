# Aetrix local stack — one-time stable tunnel configuration.
# Copy to aetrix-stack.env (git-ignored) after a stable endpoint exists:
# either a Cloudflare named tunnel or a Tailscale Funnel. Do not commit the
# filled-in file.
#
# The frontend's frontend/.env VITE_AETRIX_API_URL must contain the same public
# URL. It is compiled into the Pages bundle, so it only needs to change when the
# stable hostname changes — not when the laptop restarts.

# Cloudflare named tunnel (requires a Cloudflare-managed domain).
AETRIX_TUNNEL_MODE=named
AETRIX_PUBLIC_API_URL=https://api.example.com
AETRIX_TUNNEL_NAME=aetrix

# Free alternative: Tailscale Funnel (no domain purchase).
# Install Tailscale, sign in, enable MagicDNS/HTTPS/Funnel, then use the
# stable DNS name shown by `tailscale status --json`:
# AETRIX_TUNNEL_MODE=tailscale
# AETRIX_PUBLIC_API_URL=https://machine-name.tailnet-name.ts.net

AETRIX_FRONTEND_URL=https://aetrix.pages.dev

# Monitor settings.
AETRIX_MONITOR_INTERVAL_SECONDS=10
AETRIX_HEALTH_TIMEOUT_SECONDS=90
AETRIX_MAX_RESTARTS=5
AETRIX_RESTART_WINDOW_MINUTES=15

# A remotely managed tunnel token may be supplied through the environment as
# AETRIX_TUNNEL_TOKEN. Never put it in this file or in Git.
#
# Quick tunnels are for temporary development only and are refused unless this
# is explicitly set to 1. They are not permanent frontend connectivity.
# AETRIX_ALLOW_QUICK_TUNNEL=0
