# Aetrix V5.5 frontend — build-time configuration.
#
# Every variable here is compiled into the browser bundle and is therefore
# public. Never put a service-role key, JWT secret or Cloudflare token in this
# file: those belong to the engine's own environment.
#
# Locally: copy to frontend/.env and fill in. In CI they come from the
# workflow's repository variables; in Cloudflare Pages they are the project's
# plain-text environment variables. `.env` is git-ignored.

# Supabase project URL (public).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable / anon key (public by design; RLS and the absence of
# Data API grants are what protect the data — see migration 0005).
VITE_SUPABASE_ANON_KEY=<publishable-key>

# Public origin of the correction engine, including through an HTTPS tunnel.
# Compiled into the bundle at build time, so a new tunnel hostname needs a
# rebuild and redeploy. Leave it unset to render the explicit "no data source"
# state; never point a production build at 127.0.0.1 or localhost.
VITE_AETRIX_API_URL=

# Which provisioning policy the sign-in page should describe. It must match the
# engine's AETRIX_AUTH__OPEN_ACCESS: `true` when the engine admits any verified
# account to one shared workspace, unset when it stays invitation-only. The
# engine still decides access; this only stops the page from claiming a policy
# it cannot observe. Unset wording is accurate under either policy.
VITE_AETRIX_OPEN_ACCESS=
